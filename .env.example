# Primary Social Integration: Discord Channel Publisher (Reachable through Zscaler)
# Option A (Recommended): Discord Channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/123456789012345678/your_discord_webhook_token_here"

# Option B: Discord Bot Token + Channel ID (if using a custom Discord Bot instead of a Webhook)
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""

# Optional Secondary Integration: Telegram Bot & Channel Social Integration
# (Note: api.telegram.org is blocked on Zscaler corporate networks unless running off-VPN / cloud)
TELEGRAM_BOT_TOKEN="1234567890:AAH_your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="@your_telegram_channel_or_chat_id"

# Optional: Hosted Laya-Sports Firebase / GCP Cloud Function endpoint
# LAYA_REMOTE_URL="https://europe-west1-betscout-ai.cloudfunctions.net/laya_sports_decisions"
# LAYA_REMOTE_TOKEN=""
