{
  "name": "@betscout/sdk",
  "version": "1.1.0",
  "description": "Standalone TypeScript/Node.js Sports Data, Live Scores, Player/Team Historical Analytics & Multi-Bookmaker Odds SDK (56 sports, 1X2/Totals/Handicaps/28-outcome Correct Score, team & player profiles, surface splits, and 3s live delta streaming).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npx tsx examples/quickstart.ts",
    "showcase": "npx tsx examples/showcase-server.ts"
  },
  "keywords": [
    "betscout",
    "sports-data",
    "sports-odds",
    "correct-score",
    "live-scores",
    "player-stats",
    "team-stats",
    "typescript",
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
